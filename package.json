{
  "name": "task-front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/angular.mjs serve",
    "build": "node scripts/angular.mjs build",
    "watch": "node scripts/angular.mjs build --watch --configuration development",
    "test": "node scripts/angular.mjs test",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test e2e/smoke.spec.ts e2e/product-flows.spec.ts",
    "lint": "node scripts/lint-guard.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"e2e/**/*.ts\"",
    "audit-fix": "npm audit fix",
    "audit": "npm audit"
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.22",
    "@angular/compiler": "^21.2.22",
    "@angular/core": "^21.2.22",
    "@angular/forms": "^21.2.22",
    "@angular/platform-browser": "^21.2.22",
    "@angular/router": "^21.2.22",
    "lucide-angular": "^1.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.7.0",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^21.2.22",
    "@angular/cli": "^21.2.22",
    "@angular/compiler-cli": "^21.2.22",
    "@playwright/test": "^1.46.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^28.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "piscina": "5.3.2"
  }
}
