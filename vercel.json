{
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist/task-front/browser",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://task-back-vosa.onrender.com/api/:path*" },
    { "source": "/oauth2/:path*", "destination": "https://task-back-vosa.onrender.com/oauth2/:path*" },
    { "source": "/login/oauth2/:path*", "destination": "https://task-back-vosa.onrender.com/login/oauth2/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
