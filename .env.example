# Solo para uso local. Cambia estos valores antes de exponer la app en una red.
# Copia este archivo como .env. No compartas .env ni uses estos valores en producción.
DB_PASSWORD=change_me_local_db_password
JWT_SECRET=replace_with_a_secure_random_secret
BILLING_SIMULATE=true
STRIPE_SECRET_KEY=replace-with-your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-your-stripe-webhook-signing-secret
STRIPE_PREMIUM_PRICE=price_replace_with_premium_price_id
STRIPE_PLUS_PRICE=price_replace_with_premium_plus_price_id
FRONTEND_URL=http://localhost:4300
AWS_REGION=us-east-1
ATTACHMENTS_S3_BUCKET=
# Solo para desarrollo local con BILLING_SIMULATE=false; en producción se recomienda IAM Role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Clave publicable para Stripe.js (opcional; nunca pongas aquí una clave secreta).
STRIPE_PUBLISHABLE_KEY=
# Cookie settings: local proxy defaults to insecure Lax; production must use HTTPS.
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=Lax
# Set only when frontend and API use sibling subdomains (for example .example.com).
JWT_COOKIE_DOMAIN=
